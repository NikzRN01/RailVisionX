@echo off
REM Launch TensorBoard on the event files generated by scripts/export_tensorboard.py
REM Usage: double-click or run  scripts\launch_tensorboard.bat
REM Dashboard: http://localhost:6006
set "ROOT=%~dp0.."
"%ROOT%\.venv\Scripts\tensorboard.exe" --logdir="%ROOT%\outputs\tensorboard" --host localhost --port 6006